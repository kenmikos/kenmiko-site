---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/content";
import { render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
// Only the top two heading levels go in the jump-nav — deeper ones make it noisy.
const tocHeadings = headings.filter((h) => h.depth <= 3);
---

<BaseLayout title={project.data.title} description={project.data.description} type="article">
	<article>
		{project.data.tier && <p class="card-meta">{project.data.tier}</p>}
		<h1>{project.data.title}</h1>
		{
			project.data.scope && (
				<p class="card-meta">
					<strong>Scope:</strong> {project.data.scope}
				</p>
			)
		}
		<Image class="card-cover" src={project.data.cover} alt={project.data.coverAlt} width={800} />

		{
			project.data.deliverables.length > 0 && (
				<ul>
					{project.data.deliverables.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			)
		}

		{
			project.data.tools.length > 0 && (
				<ul class="tag-list" aria-label="Tools used">
					{project.data.tools.map((tool) => (
						<li class="tag">{tool}</li>
					))}
				</ul>
			)
		}

		{
			tocHeadings.length > 2 && (
				<nav class="toc" aria-label="Sections in this project">
					<ul>
						{tocHeadings.map((h) => (
							<li style={`margin-left: ${(h.depth - 2) * 1}rem`}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}

		<Content />
	</article>

	<p><a href="/projects/">&larr; All projects</a></p>
</BaseLayout>

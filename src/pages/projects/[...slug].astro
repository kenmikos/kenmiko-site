---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/content";
import { render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description} type="article">
	<article>
		<h1>{project.data.title}</h1>
		<Image class="card-cover" src={project.data.cover} alt={project.data.coverAlt} width={800} />

		{
			project.data.tools.length > 0 && (
				<ul class="tag-list" aria-label="Tools used">
					{project.data.tools.map((tool) => (
						<li class="tag">{tool}</li>
					))}
				</ul>
			)
		}

		<Content />
	</article>

	<p><a href="/projects/">&larr; All projects</a></p>
</BaseLayout>

---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPosts, getAllTags, getReadingTime, formatDate, getCoverHeight } from "../../../lib/content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
	const posts = await getPosts();
	const tags = getAllTags(posts);
	return tags.map((tag) => ({
		params: { tag },
		props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`Posts tagged "${tag}"`} description={`Blog posts tagged ${tag}.`}>
	<h1>Tag: {tag}</h1>
	<p><a href="/blog/">&larr; All posts</a></p>
	<ul class="card-list">
		{
			posts.map((post) => (
				<li>
					{post.data.cover && (
						<a class="card-thumb" href={`/blog/${post.id}/`}>
							<Image
								class="card-cover"
								src={post.data.cover}
								alt={post.data.coverAlt ?? ""}
								width={300}
								height={getCoverHeight(post.data.cover, 300)}
								fit="cover"
							/>
						</a>
					)}
					<div class="card-body">
						<h2 class="card-title">
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</h2>
						<p class="card-meta">
							{formatDate(post.data.date)} · {getReadingTime(post.body ?? "")} min read
						</p>
						<p>{post.data.description}</p>
					</div>
				</li>
			))
		}
	</ul>
</BaseLayout>

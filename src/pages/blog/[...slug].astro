---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, getReadingTime } from "../../lib/content";
import { render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body ?? "");
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
	<article>
		<h1>{post.data.title}</h1>
		<p class="card-meta">
			{post.data.date.toLocaleDateString("en-US", { dateStyle: "long" })} · {readingTime} min read
		</p>

		{
			post.data.summary && (
				<details class="summary-box" open>
					<summary>Summary</summary>
					<p>{post.data.summary}</p>
				</details>
			)
		}

		<Content />
	</article>

	{
		post.data.tags.length > 0 && (
			<ul class="tag-list" aria-label="Tags">
				{post.data.tags.map((tag) => (
					<li>
						<a class="tag" href={`/blog/tags/${tag}/`}>{tag}</a>
					</li>
				))}
			</ul>
		)
	}

	<p><a href="/blog/">&larr; All posts</a></p>
</BaseLayout>

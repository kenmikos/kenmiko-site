---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroBanner from "../../components/HeroBanner.astro";
import { getPosts, getAllTags, getReadingTime, formatDate, getCoverHeight } from "../../lib/content";
import { Image } from "astro:assets";

const posts = await getPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="Blog" description="Writing on analytics, budgeting, financial systems, and going back to school as a working adult.">
	<HeroBanner
		slot="banner"
		title="Writing it down :)"
		subtitle="Because the only difference between screwing around and science is writing it down. These are the results of random late-night research, calculations, and rabbit holes turned into something someone can maybe use."
	/>

	{
		tags.length > 0 && (
			<ul class="tag-list" aria-label="Filter by tag">
				{tags.map((tag) => (
					<li>
						<a class="tag" href={`/blog/tags/${tag}/`}>{tag}</a>
					</li>
				))}
			</ul>
		)
	}

	<ul class="card-list">
		{
			posts.map((post) => (
				<li>
					{post.data.cover && (
						<a class="card-thumb" href={`/blog/${post.id}/`}>
							<Image
								class="card-cover"
								src={post.data.cover}
								alt={post.data.coverAlt ?? ""}
								width={300}
								height={getCoverHeight(post.data.cover, 300)}
								fit="cover"
							/>
						</a>
					)}
					<div class="card-body">
						<h2 class="card-title">
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</h2>
						<p class="card-meta">
							{formatDate(post.data.date)} · {getReadingTime(post.body ?? "")} min read
						</p>
						<p>{post.data.description}</p>
					</div>
				</li>
			))
		}
	</ul>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, getAllTags, getReadingTime, formatDate } from "../../lib/content";
import { Image } from "astro:assets";

const posts = await getPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="Blog" description="Writing on analytics, budgeting, financial systems, and going back to school as a working adult.">
	<h1>Blog</h1>

	{
		tags.length > 0 && (
			<ul class="tag-list" aria-label="Filter by tag">
				{tags.map((tag) => (
					<li>
						<a class="tag" href={`/blog/tags/${tag}/`}>{tag}</a>
					</li>
				))}
			</ul>
		)
	}

	<ul class="card-list">
		{
			posts.map((post) => (
				<li>
					{post.data.cover && (
						<a href={`/blog/${post.id}/`}>
							<Image class="card-cover" src={post.data.cover} alt={post.data.coverAlt ?? ""} width={640} />
						</a>
					)}
					<h2 class="card-title">
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					</h2>
					<p class="card-meta">
						{formatDate(post.data.date)} · {getReadingTime(post.body ?? "")} min read
					</p>
					<p>{post.data.description}</p>
				</li>
			))
		}
	</ul>
</BaseLayout>

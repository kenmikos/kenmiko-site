---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPosts, getProjects, getReadingTime, formatDate, getCoverHeight } from "../lib/content";
import { Image } from "astro:assets";
import headerPhoto from "../assets/header-photo.jpg";

const posts = (await getPosts()).slice(0, 5);
const projects = (await getProjects()).slice(0, 3);
---

<BaseLayout
	title="Ken Miko"
	description="Data analytics, accounting systems, and making financial and technical systems legible — portfolio and blog by Ken Miko."
>
	<div class="hero-banner" slot="banner">
		<Image src={headerPhoto} alt="" width={1920} loading="eager" fetchpriority="high" />
		<div class="hero-banner-scrim"></div>
		<div class="hero-banner-content">
			<h1>Ken Miko</h1>
			<p>
				I'm finishing a BS in Accounting Information Systems with a data analytics concentration,
				and working as a project controls data analyst. This site collects portfolio projects and
				writing about making financial and technical systems legible to the people they're supposed
				to serve — analytics, budgeting, Louisiana-specific legal and financial quirks, business
				teardowns, and going back to school as a working adult.
			</p>
		</div>
	</div>

	<section>
		<div class="section-heading">
			<h2>Recent posts</h2>
			<a href="/blog/">All posts &rarr;</a>
		</div>
		<ul class="card-list">
			{
				posts.map((post) => (
					<li>
						{post.data.cover && (
							<a href={`/blog/${post.id}/`}>
								<Image
									class="card-cover"
									src={post.data.cover}
									alt={post.data.coverAlt ?? ""}
									width={640}
									height={getCoverHeight(post.data.cover, 640)}
									fit="cover"
								/>
							</a>
						)}
						<h3 class="card-title">
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</h3>
						<p class="card-meta">
							{formatDate(post.data.date)} · {getReadingTime(post.body ?? "")} min read
						</p>
						<p>{post.data.description}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-heading">
			<h2>Featured projects</h2>
			<a href="/projects/">All projects &rarr;</a>
		</div>
		<ul class="card-list">
			{
				projects.map((project) => (
					<li>
						<a href={`/projects/${project.id}/`}>
							<Image
								class="card-cover"
								src={project.data.cover}
								alt={project.data.coverAlt}
								width={640}
								height={getCoverHeight(project.data.cover, 640)}
								fit="cover"
							/>
						</a>
						<h3 class="card-title">
							<a href={`/projects/${project.id}/`}>{project.data.title}</a>
						</h3>
						<p>{project.data.description}</p>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

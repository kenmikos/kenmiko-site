---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBanner from "../components/HeroBanner.astro";
import { getPosts, getProjects, getReadingTime, formatDate, getCoverHeight } from "../lib/content";
import { Image } from "astro:assets";

const posts = (await getPosts()).slice(0, 5);
const projects = (await getProjects()).slice(0, 3);
---

<BaseLayout
	title="Ken Miko"
	description="Data analytics, accounting systems, and making financial and technical systems legible — portfolio and blog by Ken Miko."
>
	<HeroBanner
		slot="banner"
		title="Hi! I'm Ken :)"
		subtitle="I write about and build things that make financial, technical, and legal systems easier to understand. Analytics, budgets, business breakdowns, whatever I’m interested in. Poke around the projects or the blog."
	/>

	<section>
		<div class="section-heading">
			<h2>Recent posts</h2>
			<a href="/blog/">All posts &rarr;</a>
		</div>
		<ul class="card-list">
			{
				posts.map((post) => (
					<li>
						{post.data.cover && (
							<a class="card-thumb" href={`/blog/${post.id}/`}>
								<Image
									class="card-cover"
									src={post.data.cover}
									alt={post.data.coverAlt ?? ""}
									width={300}
									height={getCoverHeight(post.data.cover, 300)}
									fit="cover"
								/>
							</a>
						)}
						<div class="card-body">
							<h3 class="card-title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</h3>
							<p class="card-meta">
								{formatDate(post.data.date)} · {getReadingTime(post.body ?? "")} min read
							</p>
							<p>{post.data.description}</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-heading">
			<h2>Featured projects</h2>
			<a href="/projects/">All projects &rarr;</a>
		</div>
		<ul class="card-list">
			{
				projects.map((project) => (
					<li>
						<a class="card-thumb" href={`/projects/${project.id}/`}>
							<Image
								class="card-cover"
								src={project.data.cover}
								alt={project.data.coverAlt}
								width={300}
								height={getCoverHeight(project.data.cover, 300)}
								fit="cover"
							/>
						</a>
						<div class="card-body">
							<h3 class="card-title">
								<a href={`/projects/${project.id}/`}>{project.data.title}</a>
							</h3>
							<p>{project.data.description}</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
